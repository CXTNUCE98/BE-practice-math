generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results   Result[]
  @@map("users")
}

model Exam {
  id          String     @id @default(uuid())
  title       String
  description String?
  duration    Int        // in minutes
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  questions   Question[]
  results     Result[]
  @@map("exams")
}

model Question {
  id            String   @id @default(uuid())
  content       String   // HTML or LaTeX content
  options       String[] // Array of 4 options
  correctAnswer Int      // Index 0-3
  explanation   String?
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  @@map("questions")
}

model Result {
  id          String   @id @default(uuid())
  userId      String
  examId      String
  score       Float
  answers     Int[]    // Array of user's chosen answer indices
  startedAt   DateTime @default(now())
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  exam        Exam     @relation(fields: [examId], references: [id])
  @@map("results")
}
