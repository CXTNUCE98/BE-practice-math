{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "dist/bin/**",
      "maxDuration": 60
    },
    "api/**/*.js": {
      "includeFiles": "dist/bin/**",
      "maxDuration": 60
    }
  }
}
